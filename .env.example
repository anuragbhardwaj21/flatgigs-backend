# Required
OPENAI_API_KEY=

# Server (Docker default: 4000)
PORT=4000
NODE_ENV=production

# Docker Compose service URLs (use as-is for yarn deploy)
DATABASE_URL=postgresql://flatgigs:flatgigs@postgres:5432/flatgigs?schema=public
REDIS_URL=redis://redis:6379

# Local dev overrides (when running yarn dev with postgres/redis in Docker):
# DATABASE_URL=postgresql://flatgigs:flatgigs@localhost:5433/flatgigs?schema=public
# REDIS_URL=redis://localhost:6379
# CORS_ORIGIN=http://localhost:5173

# Optional: Inside Airbnb snapshot dates
# LISBON_SNAPSHOT=2025-12-25
# BARCELONA_SNAPSHOT=2025-12-14

# Optional: re-download CSV files even if they exist
# FORCE_DOWNLOAD=1

# Optional: Redis cache TTLs (seconds)
# CACHE_SEARCH_TTL_SECONDS=900
# CACHE_TOP_PICKS_TTL_SECONDS=3600
# CACHE_LISTING_TTL_SECONDS=86400
# CACHE_CITIES_TTL_SECONDS=86400
# CACHE_WISHLIST_TTL_SECONDS=300
# CACHE_SUMMARY_TTL_SECONDS=86400
# CACHE_RATIONALE_TTL_SECONDS=86400
# CACHE_COMPARE_TTL_SECONDS=3600
# CACHE_CHAT_TTL_SECONDS=1200
# CACHE_TRACE_TTL_SECONDS=3600
